{
  "data": {
    "group_manifest": "datasets/group_manifest.json",
    "metadata_manifest": "datasets/image_metadata.json",
    "batch_size": 16,
    "cache_dataset": true
  },
  "student": {
    "imagenet_weights": true,
    "epochs": 60,
    "learning_rate": 0.00001,
    "pretrained_warmup_epochs": 15,
    "pretrained_warmup_learning_rate": 0.001
  },
  "distillation": {
    "alpha": 0.95,
    "beta": 0.05,
    "gamma": 1.0,
    "temperature": 2.0
  },
  "runtime": {
    "output_dir": "ai/artifacts/source_labeled_enhanced_transfer",
    "early_stopping_patience": 10,
    "reduce_lr_patience": 4
  }
}
