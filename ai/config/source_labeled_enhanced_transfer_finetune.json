{
  "data": {
    "group_manifest": "datasets/group_manifest.json",
    "metadata_manifest": "datasets/image_metadata.json",
    "batch_size": 16,
    "cache_dataset": true
  },
  "student": {
    "imagenet_weights": true,
    "epochs": 30,
    "learning_rate": 0.00001,
    "pretrained_warmup_epochs": 0
  },
  "distillation": {
    "alpha": 0.95,
    "beta": 0.05,
    "gamma": 1.0,
    "temperature": 2.0
  },
  "runtime": {
    "output_dir": "ai/artifacts/source_labeled_enhanced_transfer_finetune",
    "early_stopping_patience": 8,
    "reduce_lr_patience": 4
  }
}
