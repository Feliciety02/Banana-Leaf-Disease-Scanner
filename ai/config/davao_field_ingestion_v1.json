{
  "schema_version": 1,
  "field_version": "davao-field-evaluation-v1",
  "class_names": [
    "healthy",
    "sigatoka",
    "panama-disease",
    "cordana-leaf-spot"
  ],
  "allowed_extensions": [
    ".jpg",
    ".jpeg",
    ".png",
    ".bmp",
    ".webp"
  ],
  "minimum_width": 64,
