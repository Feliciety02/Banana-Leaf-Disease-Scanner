# Local dev-automation build state (APK fingerprint + last-built URL)
.dahonmd/

# Dataset image content is ignored by default. Only dataset documentation
# (markdown) files are tracked; image files must never be committed.
datasets/*
datasets/**/*
!datasets/**/
!datasets/README.md
!datasets/.gitkeep
!datasets/**/*.md
# Human label-review CSVs are small, versioned decision evidence. Generated
# near-duplicate spreadsheets elsewhere under datasets/ remain ignored.
!datasets/reviews/labels/**/*.csv
.vscode/
dahonmd_colab_code.zip
**/.gradle/
**/build/
