{
  "name": "dahonmd-mobile-frontend",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "release:status": "node scripts/check-release-readiness.mjs --report",
    "release:check": "node scripts/check-release-readiness.mjs",
    "build:android:preview": "eas build --platform android --profile preview",
    "build:android:production": "npm run release:check && eas build --platform android --profile production",
    "benchmark": "node scripts/run-benchmark.mjs",
    "benchmark:android": "cd android && ./gradlew connectedAndroidTest -Pandroid.testInstrumentationRunnerArguments.class=expo.modules.dahonmdtflite.BenchmarkDeviceProfileTest"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-community/netinfo": "11.4.1",
    "expo": "~54.0.35",
    "expo-asset": "~12.0.13",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-secure-store": "~15.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.0",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.17",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ]
  },
  "private": true
}
