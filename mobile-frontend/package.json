{
  "name": "dahonmd-mobile-frontend",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "release:status": "node scripts/check-release-readiness.mjs --report",
    "release:check": "node scripts/check-release-readiness.mjs",
    "build:android:preview": "eas build --platform android --profile preview",
    "build:android:production": "npm run release:check && eas build --platform android --profile production",
    "benchmark": "node scripts/run-benchmark.mjs",
    "benchmark:android": "cd android && ./gradlew connectedAndroidTest -Pandroid.testInstrumentationRunnerArguments.class=expo.modules.dahonmdtflite.BenchmarkDeviceProfileTest"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-community/netinfo": "12.0.1",
    "expo": "^57.0.0",
    "expo-asset": "~57.0.17",
    "expo-background-task": "~57.0.18",
    "expo-camera": "~57.0.5",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-manipulator": "~57.0.18",
    "expo-image-picker": "~57.0.18",
    "expo-screen-capture": "~57.0.3",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.18",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "^26.6.0",
    "@types/react": "~19.2.4",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ]
  },
  "private": true
}
