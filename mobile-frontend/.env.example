# Optional connected workspace. Use your computer's LAN address for a physical
# device; 127.0.0.1 points back to the phone itself.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8001/api

# Public legal pages. Production values must use HTTPS and remain reachable
# without signing in. Put the deletion URL in Play Console's Data safety form.
EXPO_PUBLIC_PRIVACY_URL=http://192.168.1.10:8001/privacy
EXPO_PUBLIC_ACCOUNT_DELETION_URL=http://192.168.1.10:8001/account-deletion

# The offline classifier does not read this value and must continue to use the
# bundled on-device INT8 model when the API cannot be reached.
# EAS production builds reject non-HTTPS connected and legal URLs at runtime.
