{
  "expo": {
    "name": "DahonMD Field",
    "slug": "dahonmd-field",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "dahonmd",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#173f35"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dahonmd.field"
    },
    "android": {
      "package": "com.dahonmd.field",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#173f35"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow DahonMD to select a banana leaf image for diagnosis.",
          "cameraPermission": "Allow DahonMD to photograph banana leaves for diagnosis.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      "expo-asset",
      "expo-font"
    ]
  }
}
