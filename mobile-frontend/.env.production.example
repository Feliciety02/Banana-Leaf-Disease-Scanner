# Public production Laravel API. Localhost, emulator, LAN, and HTTP URLs are rejected.
EXPO_PUBLIC_API_URL=https://api.example.com/api

# Keep this aligned with the threshold validated during model evaluation.
EXPO_PUBLIC_CONFIDENCE_THRESHOLD=70

# These URLs are required for the Google Play listing and release checklist.
PLAY_STORE_PRIVACY_POLICY_URL=https://example.com/privacy
PLAY_STORE_ACCOUNT_DELETION_URL=https://example.com/account-deletion
